{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "auth:create-admin": "tsx src/auth/create-admin.ts",
    "db:migrate:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:test": "tsx --env-file=.env.test src/test/seed.ts",
    "dev:test": "tsx --env-file=.env.test src/index.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@fastify/cors": "^11.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
