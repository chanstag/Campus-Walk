# Test database and server settings. `pnpm db:setup:test` (repo root) writes the real file.
# Vitest (apps/api) and Playwright (root) both read this file; never point it at the dev database.

# Marker checked by the test runner and the test seed before truncating anything.
CAMPUS_WALK_TEST=1
# Neon connection string for the `test` branch of the project (NOT the one in .env).
DATABASE_URL=
# The E2E run starts the API on 3101 and Vite on 5174 so it can coexist with `pnpm dev`.
PORT=3101
APP_URL=http://localhost:5174
API_URL=http://localhost:3101
# Any 32+ char string; the setup script copies the one from .env.
BETTER_AUTH_SECRET=
# Optional: photo storage for test runs. Default apps/api/storage-test.
STORAGE_DIR=
