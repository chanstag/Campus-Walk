# Neon Postgres connection string. Run `pnpm db:setup` from the repo root to fill this in.
DATABASE_URL=
# Port the API listens on (default 3001)
PORT=3001

# Better Auth: signing/encryption secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the web app (trusted origin for auth requests; base of invite links).
APP_URL=http://localhost:5173
# Origin the API is reachable at (Better Auth baseURL).
API_URL=http://localhost:3001

# Optional: Neon project id. The worktree scripts (.claude/scripts/) write this so cleanup can find
# the project without a name lookup. `pnpm db:setup` finds the project by name (campus-walk) instead.
NEON_PROJECT_ID=
